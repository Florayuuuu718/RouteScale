FROM python@sha256:00f0ecbf74ff8f915020d5a40c4bc6a83f46cd7b83f47db51c7e204f0d8a3ec2
RUN rm -rf /usr/local/lib/python3.11/site-packages/*
ADD sglang-environment.tar.gz /usr/local/lib/python3.11/site-packages/
COPY console-scripts/ /usr/local/bin/
ADD cuda-toolchain.tar.gz /opt/cuda/
COPY cuda-math-functions.h /opt/cuda/targets/x86_64-linux/include/crt/math_functions.h
RUN ln -s targets/x86_64-linux/include /opt/cuda/include && ln -s targets/x86_64-linux/lib /opt/cuda/lib64
WORKDIR /workspace/RouteScale
COPY serving/ ./serving/
COPY scripts/ ./scripts/
COPY deploy/ ./deploy/
COPY config/ ./config/
COPY docs/ ./docs/
COPY results/ ./results/
COPY framework_bundle.json /image_manifest.json
ENV ROUTESCALE_IN_CONTAINER=1 ROUTESCALE_FRAMEWORK_PYTHON=python3 ROUTESCALE_MODEL_PATH=/models/Qwen3-0.6B
ENV ROUTESCALE_CUDA_HOME=/opt/cuda CUDA_HOME=/opt/cuda PATH=/opt/cuda/bin:$PATH
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 NVIDIA_DRIVER_CAPABILITIES=compute,utility
EXPOSE 1971 1972
HEALTHCHECK --start-period=600s --interval=10s --timeout=3s CMD python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:1971/ready',timeout=2)"
ENTRYPOINT ["sh", "deploy/local/sglang/entrypoint.sh"]
