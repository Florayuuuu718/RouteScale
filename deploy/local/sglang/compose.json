{
  "services": {
    "sglang": {
      "build": {"context": "../../..", "dockerfile": "deploy/local/sglang/Dockerfile"},
      "image": "routescale-sglang:local-v1",
      "ports": ["127.0.0.1:1971:1971", "127.0.0.1:1972:1972"],
      "shm_size": "1g",
      "volumes": [
        {"type": "bind", "source": "${ROUTESCALE_MODEL_DIR:?Set an absolute model path}", "target": "/models/Qwen3-0.6B", "read_only": true},
        {"type": "volume", "source": "sglang-state", "target": "/state"},
        {"type": "volume", "source": "sglang-cache", "target": "/root/.cache"}
      ],
      "deploy": {"resources": {"reservations": {"devices": [{"driver": "nvidia", "device_ids": ["0"], "capabilities": ["gpu"]}]}}},
      "stop_grace_period": "30s",
      "restart": "no"
    }
  },
  "volumes": {"sglang-state": {}, "sglang-cache": {}}
}
