# Override jupyter in Github language stats for more accurate estimate of repo code languages
# reference: https://github.com/github/linguist/blob/master/docs/overrides.md#generated-code
*.ipynb linguist-generated

# Keep executable sources consistent and frozen audit evidence byte-for-byte.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
# Unified diffs use a single space for blank context lines.
*.patch text eol=lf -whitespace
results/** -text
artifacts/** -text
